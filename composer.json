{
    "name": "jackardios/elastic-query-wizard",
    "description": "Builds Elasticsearch queries from API request parameters (filters, sorts, includes, fields, appends) in Laravel, on top of laravel-query-wizard and es-scout-driver",
    "keywords": [
        "jackardios",
        "laravel-elastic-query-wizard",
        "laravel-query-wizard",
        "es-scout-driver",
        "elastic-query-builder",
        "laravel-query-builder",
        "laravel",
        "scout",
        "elastic",
        "elasticsearch",
        "query",
        "wizard",
        "builder",
        "json",
        "api",
        "json api",
        "json-api",
        "query builder",
        "filtering",
        "sorting",
        "search"
    ],
    "homepage": "https://github.com/jackardios/elastic-query-wizard",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/jackardios/elastic-query-wizard/issues",
        "source": "https://github.com/jackardios/elastic-query-wizard"
    },
    "authors": [
        {
            "name": "Salavat Salakhutdinov",
            "email": "salavat.salahutdinov@gmail.com",
            "homepage": "https://github.com/jackardios"
        }
    ],
    "require": {
        "php": "^8.2",
        "jackardios/es-scout-driver": "^1.0.0-rc.1",
        "jackardios/laravel-query-wizard": "^3.0.0-rc.5",
        "laravel/framework": "^12.69.0 || ^13.30.0"
    },
    "require-dev": {
        "babenkoivan/elastic-migrations": "^4.0 || ^5.0",
        "fakerphp/faker": "^1.23",
        "laravel/pint": "1.30.4",
        "laravel/scout": "^10.24 || ^11.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5.50 || ^12.5.8"
    },
    "autoload": {
        "psr-4": {
            "Jackardios\\ElasticQueryWizard\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jackardios\\ElasticQueryWizard\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:feature": "phpunit --testsuite=Feature",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format-check": "pint --test",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.x-dev"
        }
    },
    "prefer-stable": true
}
